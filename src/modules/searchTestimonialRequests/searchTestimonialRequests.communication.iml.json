{
  "url": "/sites/{{parameters.site_id}}/testimonials/requests.json",
  "method": "GET",
  "qs": {
    "q": "{{ifempty(parameters.q, undefined)}}",
    "status": "{{ifempty(parameters.status, undefined)}}",
    "form_id": "{{ifempty(parameters.form_id, undefined)}}",
    "per_page": "{{min(parameters.limit, 100)}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.meta.total_pages >= pagination.page}}"
  },
  "response": {
    "iterate": "{{body.data}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  }
}
