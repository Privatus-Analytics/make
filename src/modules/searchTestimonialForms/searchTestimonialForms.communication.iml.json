{
  "url": "/sites/{{parameters.site_id}}/testimonials/forms.json",
  "method": "GET",
  "qs": {
    "q": "{{ifempty(parameters.q, undefined)}}",
    "language": "{{ifempty(parameters.language, undefined)}}",
    "sort": "{{ifempty(parameters.sort, undefined)}}",
    "direction": "{{ifempty(parameters.direction, undefined)}}",
    "per_page": "{{min(parameters.limit, 100)}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.meta.total_pages >= pagination.page}}"
  },
  "response": {
    "iterate": "{{body.data}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  }
}
