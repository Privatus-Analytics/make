  {
    "name": "site_id",
    "type": "select",
    "options": "rpc://listSites",
    "label": "Site",
    "help": "The site, from the sites this API token can open. You can also map a site ID (pa_...) from an earlier module.",
    "required": true
  },
  {
    "name": "q",
    "label": "Search",
    "help": "The search box. Words and \"quoted phrases\" search the text, title, person and company. Operators: status: kind: source: from: form: tag: collection: lang: has: is: consent: received: person: company: email: used: mentions: rating: and prop.<key>:. A comma means any of, a leading minus excludes, and terms are joined with and. Example: rating:5 has:video tag:onboarding \"saved us\"",
    "type": "text"
  },
  {
    "name": "sort",
    "label": "Sort",
    "help": "received_desc (the default), received_asc, added_desc, added_asc, rating_desc, rating_asc, person_asc, length_desc, length_asc, used_desc, used_asc, or relevance (the default when q has words, and only allowed then)",
