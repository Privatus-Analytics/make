{
  "url": "/sites/{{parameters.site_id}}/testimonials/collections.json",
  "method": "GET",
  "qs": {
    "per_page": 100
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.meta.total_pages >= pagination.page}}"
  },
  "response": {
    "iterate": "{{body.data}}",
    "limit": 300,
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    }
  }
}
