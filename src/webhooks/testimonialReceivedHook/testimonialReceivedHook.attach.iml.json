{
  "url": "/workspaces/{{connection.workspaceId}}/webhooks.json",
  "method": "POST",
  "body": {
    "url": "{{webhook.url}}",
    "events": [
      "testimonial.received"
    ],
    "enabled": true
  },
  "response": {
    "data": {
      "webhookId": "{{body.data.id}}",
      "workspaceId": "{{connection.workspaceId}}"
    }
  }
}
